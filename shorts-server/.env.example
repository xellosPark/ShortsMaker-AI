# 복사해서 shorts-server/.env 로 만들고 키를 넣으세요 (.env 는 git 에 올리지 않음)
# Google AI Studio → Get API key (무료 사용량 안에서 무료)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# 배경 영상 (둘 중 하나만 있어도 됨)
# https://pixabay.com/api/docs/ → 로그인하면 페이지 안에 키가 보임
PIXABAY_API_KEY=
# https://www.pexels.com/api/ (2026-11 현재 새 키 발급 중단)
PEXELS_API_KEY=
